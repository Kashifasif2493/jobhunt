{% extends "base.html" %}
{% block title %}Legal Information — WorldJobShunt{% endblock %}
{% block meta_desc %}Legal and seller identification information for WorldJobShunt and The Prompt Vault digital product.{% endblock %}

{% block extra_styles %}
<style>
  .page-hero {
    text-align: center; padding: 72px 20px 40px;
  }
  .page-hero h1 {
    font-family: 'Syne', sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 800; margin-bottom: 12px;
  }
  .page-hero p { color: var(--muted); font-size: 0.9rem; }

  .content-wrap {
    max-width: 780px; margin: 0 auto;
    padding: 0 20px 60px;
  }
  .policy-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px; padding: 40px;
  }
  .policy-card h2 {
    font-family: 'Syne', sans-serif;
    font-size: 1.15rem; margin: 28px 0 10px;
    color: var(--accent);
  }
  .policy-card h2:first-child { margin-top: 0; }
  .policy-card p {
    color: var(--muted); line-height: 1.8;
    font-size: 0.92rem; margin-bottom: 10px;
  }
  .policy-card ul {
    margin-bottom: 15px; padding-left: 20px;
  }
  .policy-card li {
    color: var(--muted); line-height: 1.8;
    font-size: 0.92rem; margin-bottom: 5px;
  }
  .policy-card a { color: var(--accent); text-decoration: none; }
  .policy-card a:hover { text-decoration: underline; }
</style>
{% endblock %}

